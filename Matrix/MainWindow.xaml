<Window x:Class="Matrix.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Matrix"
        mc:Ignorable="d"
        Title="Калькулятор матриці"
        Height="680" Width="1150"
        MinHeight="400" MinWidth="750"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Матриця А -->
            <GroupBox Grid.Row="0" Grid.Column="0" Header="Матриця А"
                      Margin="5" Padding="5">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="Рядків:" VerticalAlignment="Center"/>
                        <TextBox x:Name="RowsA" Text="3" Width="30" Height="20"
                                 Margin="4,0" TextAlignment="Center" MaxLength="2"/>
                        <TextBlock Text="Стовпців:" VerticalAlignment="Center"/>
                        <TextBox x:Name="ColsA" Text="3" Width="30" Height="20"
                                 Margin="4,0" TextAlignment="Center" MaxLength="2"/>
                        <Button Content="Застосувати" Tag="A" Click="MatrixAction_Click"/>
                        <Button Content="Випадково" Tag="A" Click="MatrixAction_Click"/>
                        <Button Content="Одинична" Tag="A" Click="MatrixAction_Click"/>
                        <Button Content="Очистити" Tag="A" Click="MatrixAction_Click"/>
                    </WrapPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <UniformGrid x:Name="GridA"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"/>
                    </ScrollViewer>
                </DockPanel>
            </GroupBox>

            <!-- Матриця B -->
            <GroupBox Grid.Row="0" Grid.Column="2" Header="Матриця B" 
                      Margin="5" Padding="6">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="Рядків:" VerticalAlignment="Center"/>
                        <TextBox x:Name="RowsB" Text="3" Width="30" Height="20"
                                 Margin="4,0" TextAlignment="Center" MaxLength="2"/>
                        <TextBlock Text="Стовпців:" VerticalAlignment="Center"/>
                        <TextBox x:Name="ColsB" Text="3" Width="30" Height="20"
                                 Margin="4,0" TextAlignment="Center" MaxLength="2"/>
                        <Button Content="Застосувати" Tag="B" Click="MatrixAction_Click"/>
                        <Button Content="Випадково" Tag="B" Click="MatrixAction_Click"/>
                        <Button Content="Одинична" Tag="B" Click="MatrixAction_Click"/>
                        <Button Content="Очистити" Tag="B" Click="MatrixAction_Click"/>
                    </WrapPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <UniformGrid x:Name="GridB" 
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"/>
                    </ScrollViewer>
                </DockPanel>
            </GroupBox>
            
            <!-- Операції -->
            <GroupBox Grid.Row="0" Grid.Column="1" Header="Операції"
                      Margin="5" Padding="6">
                <StackPanel Width="140">
                    <Button x:Name="btnAdd" Content="A+B" Click="btnAdd_Click"/>
                    <Button x:Name="btnMinus" Content="A-B" Click="btnMinus_Click"/>
                    <Button x:Name="btnMultiply" Content="A*B" Click="btnMultiply_Click"/>
                    <Button x:Name="btnDivide" Content="A/B" Click="btnDivide_Click"/>
                </StackPanel>
            </GroupBox>

            <!-- Матриця С -->
            <GroupBox Grid.Row="1" Grid.Column="0" Header="Результат С" 
                      Margin="5" Padding="6">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                    <UniformGrid x:Name="GridC" 
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"/>
                </ScrollViewer>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
